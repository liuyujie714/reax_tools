#!/usr/bin/env bash
# ReaxTools launcher: prefers the project venv, falls back to python3.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -x "$ROOT/venv/bin/python" ]; then
    exec "$ROOT/venv/bin/python" "$ROOT/bin/reax_tools.py" "$@"
fi

if command -v python3 >/dev/null 2>&1; then
    exec python3 "$ROOT/bin/reax_tools.py" "$@"
fi

echo "reax_tools: python3 not found" >&2
exit 1
